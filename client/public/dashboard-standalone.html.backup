                                            <path d="M-30 80 Q70 70, 150 85 T330 90" stroke="rgba(120,100,180,0.12)" stroke-width="1.5" fill="none"/>
                                            <path d="M-20 120 Q90 105, 160 125 T320 130" stroke="rgba(120,100,180,0.1)" stroke-width="1.5" fill="none"/>
                                        </svg>
                                        
                                        <!-- Header: NFC + tapp logo -->
                                        <div class="card-header">
                                            <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
                                                <circle cx="16" cy="16" r="2" fill="rgba(120,100,180,0.9)" />
                                                <path d="M16 10C12.6863 10 10 12.6863 10 16C10 19.3137 12.6863 22 16 22" 
                                                    stroke="rgba(120,100,180,0.5)" stroke-width="1.5" stroke-linecap="round"/>
                                                <path d="M16 6C10.4772 6 6 10.4772 6 16C6 21.5228 10.4772 26 16 26" 
                                                    stroke="rgba(120,100,180,0.3)" stroke-width="1.5" stroke-linecap="round"/>
                                            </svg>
                                            <h2 class="tapp-wordmark" style="color: rgba(120,100,180,0.95);">tapp</h2>
                                        </div>

                                        <!-- Footer: Member name + expiry + premium -->
                                        <div class="card-footer-real">
                                            <div>
                                                <div class="card-label-minimal" style="color: rgba(120,100,180,0.4);">Member</div>
                                                <div class="card-value" style="color: rgba(120,100,180,0.95);">Cardholder</div>
                                            </div>
                                            <div class="card-expiry-box" style="position: relative;">
                                                <div class="card-label-minimal" style="color: rgba(120,100,180,0.4);">Valid thru</div>
                                                <div class="card-value card-mono" style="color: rgba(120,100,180,0.95);">12/29</div>
                                                <div style="position: absolute; bottom: -14px; right: 0; font-size: 0.5rem; color: rgba(120,100,180,0.5); letter-spacing: 0.15em; text-transform: uppercase; font-weight: 500;">
                                                    Premium
