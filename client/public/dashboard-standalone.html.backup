                        <div class="swiper-page">
                            <span class="dot active" onclick="goToCard(0)"></span>
                            <span class="dot" onclick="goToCard(1)"></span>
                            <span class="dot" onclick="goToCard(2)"></span>
                        </div>
                    </div>
                </aside>
            </section>
        </section>
    </div>
    <script>
        // Menu functionality
        const menuBtn = document.getElementById('menu_btn');
        const closeBtn = document.getElementById('btn_close');
        const sidebar = document.getElementById("sidebar");
        
        if (menuBtn) {
            menuBtn.addEventListener('click', () => {
                sidebar.classList.add('active');
            });
        }
        
        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                sidebar.classList.remove('active');
            });
        }
        
        // Close sidebar when clicking outside
        document.addEventListener('click', (e) => {
            if (sidebar.classList.contains('active') && 
                !sidebar.contains(e.target) && 
                !menuBtn.contains(e.target)) {
                sidebar.classList.remove('active');
            }
        });
        
        function mySubmitFunction(e) {
            e.preventDefault();
            return false;
        }

        // Toggle transfer section
        function toggleTransferSection() {
            const section = document.querySelector('.transfer_money_section');
            section.classList.toggle('collapsed');
        }

        // Toggle transactions visibility
        let transactionsExpanded = false;
        function toggleTransactions() {
            const hiddenTransactions = document.querySelectorAll('.hidden-transactions');
            const btn = document.getElementById('showMoreBtn');
            const btnText = btn.querySelector('.show-more-text');
            
            transactionsExpanded = !transactionsExpanded;
            
            hiddenTransactions.forEach(section => {
                section.style.display = transactionsExpanded ? 'block' : 'none';
            });
            
            btn.classList.toggle('expanded', transactionsExpanded);
            btnText.textContent = transactionsExpanded ? 'Show less' : 'Show all';
        }

        // Notification modal functions
        function openNotificationModal() {
            const modal = document.getElementById('notificationModal');
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeNotificationModal(event) {
            if (event && event.target !== event.currentTarget) return;
            const modal = document.getElementById('notificationModal');
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }

        function markAllAsRead() {
            const unreadItems = document.querySelectorAll('.notification-item.unread');
            unreadItems.forEach(item => {
                item.classList.remove('unread');
            });
        }

        // Add click handler to notification bell
        document.addEventListener('DOMContentLoaded', () => {
            const notificationBell = document.querySelector('.topbar_icons a.alert');
            if (notificationBell) {
                notificationBell.addEventListener('click', (e) => {
                    e.preventDefault();
                    openNotificationModal();
                });
            }
        });

        // Copy account number function
        let accountVisible = false;
        
        function toggleAccountVisibility() {
            const accountNumber = document.getElementById('accountNumber');
            const toggleBtn = document.querySelector('.toggle_account_btn');
            
            accountVisible = !accountVisible;
            
            if (accountVisible) {
                accountNumber.classList.remove('hidden');
                accountNumber.textContent = '22-394932';
            } else {
                accountNumber.classList.add('hidden');
                accountNumber.textContent = '';
            }
        }
        
        function copyAccountNumber() {
            const accountNumber = '22-394932';
            const btn = document.querySelector('.copy_account_btn');
            const tooltip = document.querySelector('.copy-tooltip');
            
            // Copy to clipboard
            navigator.clipboard.writeText(accountNumber).then(() => {
                // Visual feedback
                btn.classList.add('copied');
                tooltip.classList.add('show');
                
                // Reset after 2 seconds
                setTimeout(() => {
                    btn.classList.remove('copied');
                    tooltip.classList.remove('show');
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy:', err);
            });
        }
        
        // Initialize account as hidden
        document.addEventListener('DOMContentLoaded', () => {
            const accountNumber = document.getElementById('accountNumber');
            accountNumber.classList.add('hidden');
            accountNumber.textContent = '';
        });

        // Wallet expansion for mobile (iPhone style)
        let isWalletExpanded = false;

        function expandWallet(event) {
            if (window.innerWidth <= 870 && !isWalletExpanded) {
                event.stopPropagation();
                const wallet = document.getElementById('cardsWallet');
                wallet.classList.add('expanded');
                isWalletExpanded = true;
                document.body.style.overflow = 'hidden';
            }
        }

        function closeWallet() {
            const wallet = document.getElementById('cardsWallet');
            wallet.classList.remove('expanded');
            isWalletExpanded = false;
            document.body.style.overflow = '';
        }

        // Close wallet when clicking outside (only in expanded state)
        document.addEventListener('click', (e) => {
            if (isWalletExpanded && window.innerWidth <= 870) {
                const wallet = document.getElementById('cardsWallet');
                const cardsContainer = document.querySelector('.custom-cards-container');
                if (!cardsContainer.contains(e.target) && !e.target.closest('.sliber_controller')) {
                    closeWallet();
                }
            }
        });

        // Custom cards navigation with stack effect
        let currentCard = 0;
        const totalCards = 3;

        function updateCards() {
            const cards = document.querySelectorAll('.custom-card');
            const dots = document.querySelectorAll('.swiper-page .dot');
            
            cards.forEach((card, index) => {
                // Remove all classes
                card.classList.remove('active', 'next', 'prev', 'hidden');
                
                // Calculate position relative to current card
                let position = index - currentCard;
                
                if (position === 0) {
                    // Current card
                    card.classList.add('active');
                } else if (position === 1 || (position === -2 && totalCards === 3)) {
                    // Next card
                    card.classList.add('next');
                } else if (position === -1 || (position === 2 && totalCards === 3)) {
                    // Previous card
                    card.classList.add('prev');
                } else {
                    // Hidden card
                    card.classList.add('hidden');
                }
            });
            
            // Update dots
            dots.forEach((dot, index) => {
                dot.classList.remove('active');
                if (index === currentCard) {
                    dot.classList.add('active');
                }
            });
        }

        function nextCard() {
            currentCard = (currentCard + 1) % totalCards;
            updateCards();
        }

        function prevCard() {
            currentCard = (currentCard - 1 + totalCards) % totalCards;
            updateCards();
        }

        function goToCard(index) {
            currentCard = index;
            updateCards();
        }

        // Scroll wheel navigation for desktop
        let scrollTimeout;
        let isScrolling = false;

        function handleWheelScroll(e) {
            // Only work on desktop and when hovering over cards area
            if (window.innerWidth <= 870) return;
            
            e.preventDefault();
            
            // Debounce scroll events
            if (isScrolling) return;
            isScrolling = true;
            
            clearTimeout(scrollTimeout);
            
            // Determine scroll direction
            const delta = e.deltaY || e.deltaX;
            
            if (delta > 0) {
                // Scroll down/right = next card
                nextCard();
            } else if (delta < 0) {
                // Scroll up/left = previous card
                prevCard();
            }
            
            // Reset scroll lock after delay
            scrollTimeout = setTimeout(() => {
                isScrolling = false;
            }, 600);
        }

        // Add wheel event listener to cards container
        const cardsElement = document.getElementById('cardsWallet');
        if (cardsElement) {
            cardsElement.addEventListener('wheel', handleWheelScroll, { passive: false });
        }

        // Touch swipe for mobile (when expanded)
        let touchStartX = 0;
        let touchStartY = 0;
        let touchEndX = 0;
        let touchEndY = 0;
        let isSwiping = false;

        const cardsContainer = document.querySelector('.cards-wrapper');

        if (cardsContainer) {
            // Mouse drag for desktop
            let startX = 0;
            let isDragging = false;

            cardsContainer.addEventListener('mousedown', (e) => {
                if (window.innerWidth > 870 || isWalletExpanded) {
                    startX = e.clientX;
                    isDragging = true;
                }
            });

            cardsContainer.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                e.preventDefault();
            });

            cardsContainer.addEventListener('mouseup', (e) => {
                if (!isDragging) return;
                isDragging = false;
                const diff = e.clientX - startX;
                if (Math.abs(diff) > 50) {
                    if (diff > 0) {
                        prevCard();
                    } else {
                        nextCard();
                    }
                }
            });

            cardsContainer.addEventListener('mouseleave', () => {
                isDragging = false;
            });

            // Touch events for mobile (when wallet is expanded)
            cardsContainer.addEventListener('touchstart', (e) => {
                if (isWalletExpanded) {
                    touchStartX = e.touches[0].clientX;
                    touchStartY = e.touches[0].clientY;
                    isSwiping = true;
                }
            }, { passive: true });

            cardsContainer.addEventListener('touchmove', (e) => {
                if (!isSwiping || !isWalletExpanded) return;
                touchEndX = e.touches[0].clientX;
                touchEndY = e.touches[0].clientY;
            }, { passive: true });

            cardsContainer.addEventListener('touchend', (e) => {
                if (!isSwiping || !isWalletExpanded) return;
                isSwiping = false;
                
                const diffX = touchEndX - touchStartX;
                const diffY = Math.abs(touchEndY - touchStartY);
                
                // Only trigger if horizontal swipe is dominant (not vertical scroll)
                if (Math.abs(diffX) > 50 && diffY < Math.abs(diffX)) {
                    if (diffX > 0) {
                        prevCard();
                    } else {
                        nextCard();
                    }
                }
            }, { passive: true });
        }

        // Initialize cards on page load
        document.addEventListener('DOMContentLoaded', () => {
            updateCards();
        });

        // Handle window resize
        window.addEventListener('resize', () => {
            if (window.innerWidth > 870 && isWalletExpanded) {
                closeWallet();
            }
        });
    </script>
    
    <!-- Notification Modal -->
    <div class="notification-modal-overlay" id="notificationModal" onclick="closeNotificationModal(event)">
        <div class="notification-modal" onclick="event.stopPropagation()">
            <div class="notification-header">
                <h3 class="notification-header-title">Notifications</h3>
                <button class="notification-mark-all" onclick="markAllAsRead()">Mark all read</button>
            </div>
            
            <div class="notification-item unread">
                <span class="notification-icon reward">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 6v6l4 2"/>
                    </svg>
                </span>
                <div class="notification-body">
                    <p class="notification-title">2x rewards ending soon</p>
                    <p class="notification-desc">Your 2x rewards at Casa 23 expire tonight at 11PM. Don't miss out!</p>
                </div>
                <span class="notification-time">5m ago</span>
            </div>
            
            <div class="notification-item unread">
                <span class="notification-icon event">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                </span>
                <div class="notification-body">
                    <p class="notification-title">3 friends joined Salsa Night</p>
                    <p class="notification-desc">Andrea, Carlos and Juan are going to Salsa Night tomorrow. Join them?</p>
                </div>
                <span class="notification-time">1h ago</span>
            </div>
            
            <div class="notification-item">
                <span class="notification-icon reward">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                </span>
                <div class="notification-body">
                    <p class="notification-title">You earned 840 points</p>
                    <p class="notification-desc">RD$120 cashback from Casa 23 added to your rewards.</p>
                </div>
                <span class="notification-time">3h ago</span>
            </div>
            
            <div class="notification-item">
                <span class="notification-icon event">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                </span>
                <div class="notification-body">
                    <p class="notification-title">New TAPP Drop nearby</p>
                    <p class="notification-desc">30 spots available at Mofongo House. Free appetizer + 2x points.</p>
                </div>
                <span class="notification-time">5h ago</span>
            </div>
            
            <div class="notification-item">
                <span class="notification-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </span>
                <div class="notification-body">
                    <p class="notification-title">Event split settled</p>
                    <p class="notification-desc">Andrea paid their share (RD$3,200) for Mambo Night.</p>
                </div>
                <span class="notification-time">1d ago</span>
            </div>
        </div>
    </div>

    <script>
    // Entrance Animations on Load
    document.addEventListener('DOMContentLoaded', function() {
        // Apply animations to different sections
        const topbar = document.querySelector('.topbar');
        const balanceCard = document.querySelector('.bank_balance_card');
        const timePeriodTabs = document.querySelector('.time-period-tabs');
        const noticeCard = document.querySelector('.tapp-notice-card');
        const aetherCard = document.querySelector('.aether-card');
        const networkCard = document.querySelector('.network-stats-card');
        const transactionSection = document.querySelector('.transaction_info');
        const transferSection = document.querySelector('.transfer_money_section');
        const cardsSection = document.querySelector('.cards');
        
        if (topbar) {
            topbar.classList.add('animate-fadeInDown');
        }
        
        if (balanceCard) {
            balanceCard.classList.add('animate-fadeInUp', 'animate-delay-100');
        }
        
        if (timePeriodTabs) {
            timePeriodTabs.classList.add('animate-fadeIn', 'animate-delay-200');
        }
        
        if (noticeCard) {
            noticeCard.classList.add('animate-fadeInUp', 'animate-delay-300');
        }
        
        if (aetherCard) {
            aetherCard.classList.add('animate-scaleIn', 'animate-delay-400');
        }
        
        if (networkCard) {
            networkCard.classList.add('animate-fadeInUp', 'animate-delay-200');
        }
        
        if (transactionSection) {
            transactionSection.classList.add('animate-fadeInUp', 'animate-delay-300');
        }
        
        if (transferSection) {
            transferSection.classList.add('animate-fadeInLeft', 'animate-delay-100');
        }
        
        if (cardsSection) {
            cardsSection.classList.add('animate-fadeInUp', 'animate-delay-200');
        }
    });
    </script>
</body>
</html>
