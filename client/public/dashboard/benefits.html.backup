<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benefits - TAPP</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;1,500&family=Poppins:wght@100;200;300;400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            text-decoration: none;
            border: none;
        }

        ::-webkit-scrollbar {
            display: none;
        }

        :root {
            --font-poppins: 'Poppins', sans-serif;
            --ink: #0e1116;
            --muted: #5b6472;
            --surface: #ffffff;
            --bg: #f8f9fa;
            --text-grey: #a1a3af;
            --border: rgba(15, 23, 42, 0.08);
            --border-strong: rgba(15, 23, 42, 0.12);
        }

        body {
            position: relative;
            width: 100%;hay 
            max-height: 100vh;
            background: var(--bg);
            overflow: hidden;
            font-family: 'Inter', -apple-system, sans-serif;
        }

        @media screen and (min-width: 1024px) {
            body {
                zoom: 0.85;
                -moz-transform: scale(0.85);
                -moz-transform-origin: 0 0;
            }
        }

        body::after {
            content: '';
            position: absolute;
            top: 0%;
            right: 0%;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: #ffd8d1;
            filter: blur(100px);
            z-index: -2;
        }

        body::before {
            content: '';
            position: absolute;
            bottom: 0%;
            left: 0%;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: #c5b9ff;
            filter: blur(100px);
            z-index: -1;
        }

        /* Container with sidebar */
        .container {
            position: relative;
            width: 100vw;
            min-height: 100vh;
            overflow-x: hidden;
            overflow-y: hidden;
            display: grid;
            grid-template-columns: 280px 1fr;
            z-index: 10;
        }

        /* Sidebar */
        nav {
            position: relative;
            width: 280px;
            max-height: 100vh;
            overflow-x: hidden;
            overflow-y: scroll;
            background: url('https://raw.githubusercontent.com/shyamtala003/finance_dashboard/%40sjtala/images/bg2.png');
            background-attachment: fixed;
            background-size: 100%;
            background-repeat: no-repeat;
            background-position-y: 20%;
            background-position-x: 20%;
            border-right: 2px solid rgba(195, 195, 195, 0.8);
            font-family: var(--font-poppins);
            z-index: 99;
            display: flex;
            flex-direction: column;
        }

        nav.sidebar #btn_close {
            position: absolute;
            top: 20px;
            right: 20px;
            display: none;
            place-content: center;
            padding: 8px;
            background: #ffffff;
            border-radius: 8px;
        }

        nav .logo {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px;
            flex-shrink: 0;
        }

        nav .logo svg {
            width: 40px;
            height: 40px;
        }

        nav .logo span {
            font-weight: 200;
            font-size: 24px;
            letter-spacing: 0.1em;
            text-transform: lowercase;
        }

        .nav_links {
            margin-top: 20px;
            width: 100%;
        }

        .nav_links a.nav_link {
            display: flex;
            gap: 12px;
            align-items: center;
            padding: 12px 20px;
            color: var(--text-grey);
            font-size: 15px;
            text-transform: capitalize;
            transition: all 0.3s ease;
            border-radius: 12px;
            margin: 4px 12px;
        }

        .nav_link_icon {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav_link_icon svg {
            stroke: var(--text-grey);
            transition: stroke 0.3s ease;
        }

        a.nav_link svg .icon {
            fill: var(--text-grey);
        }

        .nav_links a.nav_link:hover .nav_link_text,
        .nav_links a.active .nav_link_text {
            color: var(--ink);
        }

        .nav_links a.nav_link:hover .nav_link_icon svg,
        .nav_links a.active .nav_link_icon svg {
            stroke: var(--ink);
        }

        .nav_links a.active {
            background: rgba(0, 0, 0, 0.05);
        }

        .nav_links a.nav_link:hover svg .icon,
        .nav_links a.active svg .icon {
            fill: var(--btn-primary);
        }

        .life_cover_offer {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
        }

        .life_cover_offer img {
            width: 130px;
            height: 150px;
        }

        .life_cover_offer .life_cover_text {
            padding-inline: 20px;
            margin-top: 20px;
        }

        .life_cover_text p.title {
            font-size: 14px;
            color: var(--ink);
            font-weight: 600;
            text-align: center;
        }

        .life_cover_text p.desc {
            font-size: 12px;
            color: #464646;
            font-weight: 400;
            text-align: center;
        }

        .life_cover_offer a {
            margin-top: 20px;
            margin-inline: 20px;
            width: 85%;
            padding: 10px 20px;
            color: #0e1116;
            border: 1px solid rgba(15, 23, 42, 0.12);
            border-radius: 999px;
            text-transform: none;
            text-align: center;
            font-weight: 500;
            font-size: 13px;
            transition: all 180ms ease;
        }

        .life_cover_offer a:hover {
            background: #0e1116;
            color: #ffffff;
            border-color: #0e1116;
        }

        .profile {
            margin: 20px auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 85%;
            padding: 16px;
            background: #ffffff;
            border-radius: 30px;
            transition: all 180ms ease;
            cursor: pointer;
            flex-shrink: 0;
        }

        .profile .img_with_name {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .profile .img_with_name img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
        }

        .profile .img_with_name p.name {
            color: #0e1116;
            font-weight: 600;
            text-transform: none;
            line-height: 14px;
            font-size: 14px;
        }

        .profile .img_with_name p.occupation {
            color: #5b6472;
            text-transform: none;
            font-size: 13px;
            font-weight: 500;
        }

        .profile .icon {
            fill: #5b6472;
            transition: fill 180ms ease;
        }

        .profile:hover {
            background: rgba(14, 17, 22, 0.04);
        }

        .profile:hover .icon {
            fill: #0e1116;
        }

        /* Main content */
        .main-content {
            width: 100%;
            height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
        }

        /* Mobile menu button */
        #menu_btn {
            position: fixed;
            top: 24px;
            left: 24px;
            width: 44px;
            height: 44px;
            display: none;
            place-items: center;
            background: #ffffff;
            padding: 10px;
            border-radius: 14px;
            cursor: pointer;
            border: 1px solid var(--border);
            box-shadow: 0 2px 8px rgba(14, 17, 22, 0.08);
            z-index: 100;
            transition: all 180ms ease;
        }

        #menu_btn:hover {
            background: rgba(14, 17, 22, 0.04);
            border-color: var(--border-strong);
        }

        #menu_btn svg {
            fill: var(--ink);
        }

        /* Benefits page styling */
        .benefits-container {
            max-width: 1800px;
            margin: 0 auto;
            padding: 48px 60px;
        }

        .page-title {
            font-size: 56px;
            font-weight: 700;
            letter-spacing: -0.03em;
            margin-bottom: 16px;
            color: var(--ink);
            text-align: right;
        }

        .page-subtitle {
            font-size: 18px;
            color: var(--muted);
            margin-bottom: 60px;
            line-height: 1.6;
            max-width: 700px;
            text-align: right;
            margin-left: auto;
        }

        /* Display Cards (Stacked) - Improved sizing */
        .display-cards {
            position: relative;
            margin-bottom: 60px;
            height: 320px;
        }

        .display-card {
            position: absolute;
            width: 100%;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 28px;
            padding: 40px;
            transition: all 420ms cubic-bezier(0.23, 1, 0.32, 1);
            box-shadow: 0 2px 8px rgba(14, 17, 22, 0.06);
        }

        .display-card:nth-child(1) {
            z-index: 3;
            transform: translateY(0) scale(1);
        }

        .display-card:nth-child(2) {
            z-index: 2;
            transform: translateY(24px) scale(0.97);
            opacity: 0.7;
        }

        .display-card:nth-child(3) {
            z-index: 1;
            transform: translateY(48px) scale(0.94);
            opacity: 0.4;
        }

        .display-card:hover {
            transform: translateY(-8px) scale(1.01);
            box-shadow: 0 12px 32px rgba(14, 17, 22, 0.12);
        }

        .display-card-badge {
            display: inline-block;
            padding: 8px 16px;
            background: rgba(36, 204, 167, 0.1);
            border: 1px solid rgba(36, 204, 167, 0.2);
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #24cca7;
            margin-bottom: 20px;
        }

        .display-card-title {
            font-size: 32px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 16px;
        }

        .display-card-desc {
            font-size: 16px;
            line-height: 1.6;
            color: var(--muted);
            margin-bottom: 28px;
        }

        .display-card-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0 28px;
            height: 48px;
            border-radius: 999px;
            background: var(--ink);
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 180ms ease;
        }

        .display-card-btn:hover {
            background: #1a1f28;
            transform: translateY(-2px);
        }

        /* Stats Grid - Improved sizing */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin-bottom: 60px;
        }

        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 32px;
            transition: all 220ms ease;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(14, 17, 22, 0.08);
        }

        .stat-card.large {
            grid-column: span 2;
            background: var(--ink);
            color: white;
        }

        .stat-label {
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 16px;
        }

        .stat-card.large .stat-label {
            color: rgba(255, 255, 255, 0.6);
        }

        .stat-value {
            font-size: 40px;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .stat-card.large .stat-value {
            font-size: 56px;
        }

        /* Vista Loader - Improved sizing */
        .loader-section {
            margin: 60px 0;
            padding: 80px 40px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 28px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .vista-loader {
            width: 56px;
            height: 56px;
            position: relative;
        }

        .vista-loader__track {
            width: 100%;
            height: 100%;
            border-radius: 999px;
            border: 3px solid rgba(14, 17, 22, 0.08);
            position: absolute;
        }

        .vista-loader__fill {
            width: 100%;
            height: 100%;
            border-radius: 999px;
            border: 3px solid var(--ink);
            border-top-color: transparent;
            border-right-color: transparent;
            position: absolute;
            animation: spin 1s cubic-bezier(0.4, 0.15, 0.6, 0.85) infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .loader-text {
            margin-top: 24px;
            font-size: 16px;
            font-weight: 500;
            color: var(--muted);
        }

        /* Benefits Grid - 3 columns, better spacing */
        .benefits-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
            margin-bottom: 60px;
        }

        /* Benefit Card - TAPP brand colors */
        .benefit-card {
            position: relative;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 28px;
            padding: 28px;
            color: var(--ink);
            display: flex;
            flex-direction: column;
            gap: 18px;
            transition: all 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
            overflow: hidden;
            box-shadow: 0 1px 2px rgba(14, 17, 22, 0.04);
        }

        .benefit-card:hover {
            transform: translateY(-4px);
            border-color: var(--border-strong);
            box-shadow: 0 8px 24px rgba(14, 17, 22, 0.08);
        }

        .benefit-meta-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
        }

        .benefit-index {
            font-family: 'Inter', sans-serif;
            font-style: normal;
            font-weight: 600;
            font-size: 22px;
            color: var(--ink);
        }

        .benefit-index em {
            font-size: 13px;
            color: var(--muted);
            margin-right: 4px;
        }

        .benefit-badge-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .benefit-figure {
            margin: 0;
            border-radius: 16px;
            overflow: hidden;
            aspect-ratio: 16 / 9;
            background: var(--bg);
            border: 1px solid var(--border);
        }

        .benefit-figure img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.95;
            transition: all 320ms ease;
        }

        .benefit-card:hover .benefit-figure img {
            transform: scale(1.05);
            opacity: 1;
        }

        .benefit-title {
            font-size: 20px;
            font-weight: 800;
            line-height: 1.2;
            letter-spacing: -0.01em;
            color: var(--ink);
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .benefit-title em {
            font-family: 'Inter', sans-serif;
            font-style: italic;
            font-weight: 600;
            text-transform: none;
        }

        /* TAPP Tooltip */
        .obra-tooltip-trigger {
            position: relative;
            display: inline-flex;
            cursor: help;
        }

        .obra-tooltip-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            height: 20px;
            border-radius: 999px;
            background: rgba(14, 17, 22, 0.05);
            border: 1px solid var(--border-strong);
            color: var(--muted);
            font-family: 'Inter', sans-serif;
            font-style: italic;
            font-size: 12px;
            transition: all 180ms ease;
        }

        .obra-tooltip-trigger:hover .obra-tooltip-icon {
            background: var(--ink);
            color: var(--surface);
            border-color: var(--ink);
        }

        .obra-tooltip {
            position: absolute;
            bottom: calc(100% + 12px);
            left: 50%;
            transform: translateX(-50%);
            width: max-content;
            max-width: 240px;
            padding: 12px 16px;
            background: var(--ink);
            border: 1px solid rgba(14, 17, 22, 0.1);
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(14, 17, 22, 0.16);
            opacity: 0;
            pointer-events: none;
            transition: opacity 220ms ease;
            z-index: 1000;
            font-size: 13px;
            line-height: 1.5;
            color: rgba(255, 255, 255, 0.85);
        }

        .obra-tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 6px solid transparent;
            border-right: 6px solid transparent;
            border-top: 6px solid var(--ink);
        }

        .obra-tooltip-trigger:hover .obra-tooltip {
            opacity: 1;
        }

        .benefit-desc {
            font-size: 14px;
            line-height: 1.5;
            color: var(--muted);
        }

        .benefit-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid var(--border);
            padding-top: 18px;
            margin-top: auto;
        }

        .benefit-tag {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .benefit-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--ink);
            text-decoration: none;
            cursor: pointer;
            transition: color 180ms ease;
        }

        .benefit-link:hover {
            color: #000000;
        }
        }

        /* Interactive Section */
        .interactive-section {
            margin: 80px 0 60px;
        }

        .section-title {
            font-size: 36px;
            font-weight: 700;
            letter-spacing: -0.01em;
            margin-bottom: 12px;
        }

        .section-desc {
            font-size: 17px;
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 48px;
        }

        .interactive-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 48px;
        }

        /* Vista Radio buttons */
        .vista-radios {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .vista-radio {
            position: relative;
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 18px 22px;
            background: #1a2333;
            border: 1px solid #2a3142;
            border-radius: 14px;
            cursor: pointer;
            transition: border-color 220ms cubic-bezier(0.22, 1, 0.36, 1);
        }

        .vista-radio:hover {
            border-color: #3a4256;
        }

        .vista-radio:has(input:checked) {
            border-color: #f4efe3;
        }

        .vista-radio input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .vista-radio__mark {
            position: relative;
            width: 20px;
            height: 20px;
            border-radius: 999px;
            background: transparent;
            border: 1px solid #3a4256;
            flex-shrink: 0;
            transition: border-color 180ms ease;
        }

        .vista-radio input:checked + .vista-radio__mark {
            border-color: #f4efe3;
        }

        .vista-radio input:checked + .vista-radio__mark::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 11px;
            height: 11px;
            border-radius: 999px;
            background: #f4efe3;
            transform: translate(-50%, -50%);
        }

        .vista-radio__copy {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .vista-radio__title {
            font-weight: 600;
            font-size: 16px;
            letter-spacing: -0.005em;
            color: #f4efe3;
        }

        .vista-radio__meta {
            font-size: 12px;
            color: #9aa0b0;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-weight: 600;
        }

        /* Cairn Input Fields */
        .fields-group {
            display: flex;
            flex-direction: column;
            gap: 28px;
        }

        .cairn-field {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .cairn-field__label {
            font-weight: 500;
            font-size: 12px;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: #9aa0a6;
            transition: color 180ms ease;
        }

        .cairn-field__input {
            display: block;
            width: 100%;
            background-color: transparent;
            color: #f4f1ea;
            font-family: inherit;
            font-size: 16px;
            line-height: 1.6;
            padding: 12px 0;
            margin: 0;
            border: 0;
            border-bottom: 1px solid #23262a;
            border-radius: 0;
            outline: none;
            transition: border-color 180ms ease;
        }

        .cairn-field__input::placeholder {
            color: #9aa0a6;
        }

        .cairn-field__input:hover {
            border-bottom-color: #9aa0a6;
        }

        .cairn-field__input:focus {
            border-bottom-color: #a7e0c2;
        }

        .cairn-field:focus-within .cairn-field__label {
            color: #a7e0c2;
        }

        .cairn-field__help {
            font-size: 14px;
            line-height: 1.55;
            color: #9aa0a6;
        }

        /* CTA Section */
        .cta-section {
            margin: 80px 0 60px;
        }

        .cta-card {
            background: var(--ink);
            color: var(--surface);
            border-radius: 32px;
            padding: 72px;
            position: relative;
            overflow: hidden;
            text-align: center;
        }

        .cta-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(
                circle at 20% 50%,
                rgba(255, 255, 255, 0.06) 0%,
                transparent 50%
            );
            pointer-events: none;
        }

        .cta-title {
            font-size: 48px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 20px;
            position: relative;
        }

        .cta-desc {
            font-size: 17px;
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 36px;
            max-width: 640px;
            margin-left: auto;
            margin-right: auto;
            position: relative;
        }

        .vista-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            height: 56px;
            padding: 0 36px;
            border-radius: 999px;
            background: #f4efe3;
            color: #0c1320;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: -0.005em;
            cursor: pointer;
            box-shadow: inset 0 0 0 1px rgba(12, 19, 32, 0.06);
            transition: all 220ms cubic-bezier(0.22, 0.61, 0.36, 1);
            border: none;
        }

        .vista-btn svg {
            width: 18px;
            height: 18px;
            stroke-width: 1.75;
            stroke: currentColor;
            fill: none;
        }

        .vista-btn:hover {
            background: #ffffff;
            transform: translateY(-2px);
        }

        .vista-btn:active {
            transform: translateY(1px);
        }

        /* Responsive - Mobile */
        @media (max-width: 1400px) {
            .benefits-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 1024px) {
            body {
                zoom: 1;
            }

            .container {
                grid-template-columns: 1fr;
            }

            nav {
                position: fixed;
                left: -100%;
                top: 0;
                height: 100vh;
                z-index: 999;
                transition: left 0.3s ease;
                background: #ffffff;
            }

            nav.active {
                left: 0;
            }

            nav.sidebar #btn_close {
                display: grid;
            }

            #menu_btn {
                display: grid;
            }

            .benefits-container {
                padding: 64px 20px 24px;
            }

            .page-title {
                font-size: 28px;
            }

            .page-subtitle {
                font-size: 14px;
                margin-bottom: 32px;
                max-width: 100%;
            }

            .display-cards {
                height: 220px;
                margin-bottom: 32px;
            }

            .display-card {
                padding: 20px;
            }

            .display-card-badge {
                font-size: 9px;
                padding: 6px 12px;
                margin-bottom: 12px;
            }

            .display-card-title {
                font-size: 18px;
                margin-bottom: 10px;
            }

            .display-card-desc {
                font-size: 13px;
                margin-bottom: 16px;
            }

            .display-card-btn {
                height: 38px;
                padding: 0 20px;
                font-size: 13px;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
                margin-bottom: 32px;
            }

            .stat-card {
                padding: 18px;
            }

            .stat-card.large {
                grid-column: span 2;
            }

            .stat-label {
                font-size: 10px;
                margin-bottom: 10px;
            }

            .stat-value {
                font-size: 24px;
            }

            .stat-card.large .stat-value {
                font-size: 32px;
            }

            .loader-section {
                padding: 40px 24px;
                margin: 32px 0;
            }

            .vista-loader {
                width: 44px;
                height: 44px;
            }

            .loader-text {
                font-size: 14px;
                margin-top: 16px;
            }

            .benefits-grid {
                grid-template-columns: 1fr;
                gap: 16px;
                margin-bottom: 32px;
            }

            .benefit-card {
                padding: 20px;
                gap: 14px;
            }

            .benefit-index {
                font-size: 18px;
            }

            .benefit-index em {
                font-size: 11px;
            }

            .benefit-badge-label {
                font-size: 9px;
            }

            .benefit-title {
                font-size: 16px;
            }

            .benefit-desc {
                font-size: 13px;
            }

            .benefit-footer {
                padding-top: 14px;
            }

            .benefit-tag {
                font-size: 10px;
            }

            .benefit-link {
                font-size: 11px;
            }

            .display-card:nth-child(2),
            .display-card:nth-child(3) {
                display: none;
            }

            .interactive-grid {
                grid-template-columns: 1fr;
                gap: 24px;
            }

            .interactive-section {
                margin: 48px 0 32px;
            }

            .section-title {
                font-size: 22px;
                margin-bottom: 8px;
            }

            .section-desc {
                font-size: 14px;
                margin-bottom: 32px;
            }

            .vista-radio {
                padding: 14px 16px;
            }

            .vista-radio__title {
                font-size: 14px;
            }

            .vista-radio__meta {
                font-size: 11px;
            }

            .cairn-field__label {
                font-size: 11px;
            }

            .cairn-field__input {
                font-size: 14px;
                padding: 10px 0;
            }

            .cairn-field__help {
                font-size: 12px;
            }

            .cta-section {
                margin: 48px 0 32px;
            }

            .cta-card {
                padding: 36px 24px;
            }

            .cta-title {
                font-size: 24px;
                margin-bottom: 14px;
            }

            .cta-desc {
                font-size: 14px;
                margin-bottom: 24px;
            }

            .vista-btn {
                height: 44px;
                padding: 0 24px;
                font-size: 14px;
            }
        }

        @media (max-width: 768px) {
            .benefits-container {
                padding: 56px 14px 18px;
            }

            .page-title {
                font-size: 22px;
            }

            .page-subtitle {
                font-size: 12px;
            }

            .display-card {
                padding: 18px;
            }

            .display-card-title {
                font-size: 16px;
            }

            .display-card-desc {
                font-size: 12px;
            }

            .section-title {
                font-size: 20px;
            }

            .cta-title {
                font-size: 22px;
            }

            .cta-card {
                padding: 28px 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Sidebar -->
        <nav class="sidebar" id="sidebar">
            <button id="btn_close">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16">
                    <path fill="none" d="M0 0h24v24H0z" />
                    <path d="M12 10.586l4.95-4.95 1.414 1.414-4.95 4.95 4.95 4.95-1.414 1.414-4.95-4.95-4.95 4.95-1.414-1.414 4.95-4.95-4.95-4.95L7.05 5.636z" />
                </svg>
            </button>
            <div class="logo">
                <svg width="40" height="40" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="16" cy="16" r="2.5" fill="currentColor" />
                    <path d="M16 9C12.134 9 9 12.134 9 16C9 19.866 12.134 23 16 23" 
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
                    <path d="M16 5C9.925 5 5 9.925 5 16C5 22.075 9.925 27 16 27" 
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
                </svg>
                <span>tapp</span>
            </div>
            <div class="nav_links">
                <a href="/dashboard/user" class="nav_link" aria-label="dashboard">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7"/>
                            <rect x="14" y="3" width="7" height="7"/>
                            <rect x="14" y="14" width="7" height="7"/>
                            <rect x="3" y="14" width="7" height="7"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Dashboard</div>
                </a>
                <a href="/dashboard/benefits" class="nav_link active" aria-label="benefits">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 7h-9"/>
                            <path d="M14 17H5"/>
                            <circle cx="17" cy="17" r="3"/>
                            <circle cx="7" cy="7" r="3"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Benefits</div>
                </a>
                <a href="/dashboard/events" class="nav_link" aria-label="events">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Events</div>
                </a>
                <a href="/dashboard/explore" class="nav_link" aria-label="explore">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Explore</div>
                </a>
                <a href="#" class="nav_link" aria-label="cards">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="5" width="20" height="14" rx="2"/>
                            <line x1="2" y1="10" x2="22" y2="10"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Cards</div>
                </a>
                <a href="#" class="nav_link" aria-label="wallet">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/>
                            <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/>
                            <path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Wallet</div>
                </a>
                <a href="#" class="nav_link" aria-label="settings">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Settings</div>
                </a>
            </div>
            <div class="life_cover_offer">
                <img src="https://raw.githubusercontent.com/shyamtala003/finance_dashboard/%40sjtala/images/women.svg" alt="" />
                <div class="life_cover_text">
                    <p class="title">Congratulations!</p>
                    <p class="desc">You'r eligible for instant Life cover upto 2,00,000 without any medical test for documentation</p>
                </div>
                <a href="#">buy now</a>
            </div>
            <div class="profile">
                <div class="img_with_name">
                    <img src="https://raw.githubusercontent.com/shyamtala003/finance_dashboard/%40sjtala/images/profile_pic.webp" alt="">
                    <div>
                        <p class="name">shyam tala</p>
                        <p class="occupation">Bussiness</p>
                    </div>
                </div>
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20">
                    <path d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8.009 8.009 0 0 1-8 8z"/>
                    <path d="M12 6a3.5 3.5 0 0 0-3.5 3.5h2A1.5 1.5 0 1 1 12 11a1 1 0 0 0-1 1v2h2v-1.16A3.49 3.49 0 0 0 12 6zm-1 9h2v2h-2z"/>
                </svg>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Mobile menu button -->
            <button id="menu_btn">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18">
                    <path fill="none" d="M0 0h24v24H0z" />
                    <path d="M3 4h18v2H3V4zm0 7h12v2H3v-2zm0 7h18v2H3v-2z" />
                </svg>
            </button>

            <div class="benefits-container">
                <h1 class="page-title">Your Benefits</h1>
                <p class="page-subtitle">Unlock exclusive rewards, experiences, and perks across the TAPP network</p>

                <!-- Display Cards Stacked - NEW ELEMENT -->
                <div class="display-cards">
                    <div class="display-card">
                        <span class="display-card-badge">Featured</span>
                        <h3 class="display-card-title">Weekend Double Rewards</h3>
                        <p class="display-card-desc">
                            This Saturday and Sunday, earn 2x points at all TAPP merchants. Plus unlock 1,000 bonus points.
                        </p>
                        <button class="display-card-btn">Learn More →</button>
                    </div>
                    <div class="display-card">
                        <span class="display-card-badge">New</span>
                        <h3 class="display-card-title">Premium Drop Tonight</h3>
                        <p class="display-card-desc">
                            Join 50 members for exclusive wine tasting at Vinoteca del Mar. Limited spots available.
                        </p>
                        <button class="display-card-btn">Reserve Spot →</button>
                    </div>
                    <div class="display-card">
                        <span class="display-card-badge">Coming Soon</span>
                        <h3 class="display-card-title">Network Expansion</h3>
                        <p class="display-card-desc">
                            10 new merchants joining next month. Be the first to tap and earn welcome bonuses.
                        </p>
                        <button class="display-card-btn">Get Notified →</button>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="stats-grid">
                    <div class="stat-card large">
                        <div class="stat-label">Total Earned</div>
                        <div class="stat-value">2,840</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Active</div>
                        <div class="stat-value">24</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Rating</div>
                        <div class="stat-value">4.9</div>
                    </div>
                </div>

                <!-- Vista Loader Section - NEW ELEMENT -->
                <div class="loader-section">
                    <div class="vista-loader">
                        <div class="vista-loader__track"></div>
                        <div class="vista-loader__fill"></div>
                    </div>
                    <p class="loader-text">Checking for new personalized offers...</p>
                </div>

                <!-- Benefits Grid with Card Features -->
                <div class="benefits-grid">
                    <!-- Benefit 1: Cashback -->
                    <article class="benefit-card">
                        <header class="benefit-meta-header">
                            <span class="benefit-index"><em>n°</em>001</span>
                            <span class="benefit-badge-label">Core Feature</span>
                        </header>
                        <figure class="benefit-figure">
                            <img src="https://images.unsplash.com/photo-1563013544-824ae1b704d3?w=600&h=400&fit=crop" alt="Cashback">
                        </figure>
                        <div>
                            <h3 class="benefit-title">
                                Cashback <em>Rewards</em>
                                <span class="obra-tooltip-trigger">
                                    <span class="obra-tooltip-icon">i</span>
                                    <span class="obra-tooltip">Earn up to 5% back on every purchase with your TAPP card</span>
                                </span>
                            </h3>
                            <p class="benefit-desc">
                                Get instant cashback on every tap. Earn rewards automatically and redeem anytime at participating merchants.
                            </p>
                        </div>
                        <footer class="benefit-footer">
                            <span class="benefit-tag">Up to 5%</span>
                            <a href="#" class="benefit-link">Learn More →</a>
                        </footer>
                    </article>

                    <!-- Benefit 2: Discounts -->
                    <article class="benefit-card">
                        <header class="benefit-meta-header">
                            <span class="benefit-index"><em>n°</em>002</span>
                            <span class="benefit-badge-label">Exclusive</span>
                        </header>
                        <figure class="benefit-figure">
                            <img src="https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?w=600&h=400&fit=crop" alt="Discounts">
                        </figure>
                        <div>
                            <h3 class="benefit-title">
                                Member <em>Discounts</em>
                                <span class="obra-tooltip-trigger">
                                    <span class="obra-tooltip-icon">i</span>
                                    <span class="obra-tooltip">Access exclusive deals at 200+ partner locations</span>
                                </span>
                            </h3>
                            <p class="benefit-desc">
                                Unlock special discounts at restaurants, cafes, and shops across the network. Save more every time you tap.
                            </p>
                        </div>
                        <footer class="benefit-footer">
                            <span class="benefit-tag">200+ Partners</span>
                            <a href="#" class="benefit-link">Browse Deals →</a>
                        </footer>
                    </article>

                    <!-- Benefit 3: Split Function -->
                    <article class="benefit-card">
                        <header class="benefit-meta-header">
                            <span class="benefit-index"><em>n°</em>003</span>
                            <span class="benefit-badge-label">Smart Pay</span>
                        </header>
                        <figure class="benefit-figure">
                            <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=600&h=400&fit=crop" alt="Split">
                        </figure>
                        <div>
                            <h3 class="benefit-title">
                                Split <em>Payment</em>
                            </h3>
                            <p class="benefit-desc">
                                Divide bills instantly with friends. Request payment via QR code or link. No more awkward calculations.
                            </p>
                        </div>
                        <footer class="benefit-footer">
                            <span class="benefit-tag">Free Feature</span>
                            <a href="#" class="benefit-link">Try It →</a>
                        </footer>
                    </article>

                    <!-- Benefit 4: Expense Tracking -->
                    <article class="benefit-card">
                        <header class="benefit-meta-header">
                            <span class="benefit-index"><em>n°</em>004</span>
                            <span class="benefit-badge-label">Analytics</span>
                        </header>
                        <figure class="benefit-figure">
                            <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&h=400&fit=crop" alt="Tracking">
                        </figure>
                        <div>
                            <h3 class="benefit-title">
                                Expense <em>Tracking</em>
                                <span class="obra-tooltip-trigger">
                                    <span class="obra-tooltip-icon">i</span>
                                    <span class="obra-tooltip">Auto-categorize spending with smart insights</span>
                                </span>
                            </h3>
                            <p class="benefit-desc">
                                Track every transaction automatically. View spending patterns, set budgets, and get monthly insights.
                            </p>
                        </div>
                        <footer class="benefit-footer">
                            <span class="benefit-tag">Real-time</span>
                            <a href="#" class="benefit-link">View Stats →</a>
                        </footer>
                    </article>

                    <!-- Benefit 5: Virtual Cards -->
                    <article class="benefit-card">
                        <header class="benefit-meta-header">
                            <span class="benefit-index"><em>n°</em>005</span>
                            <span class="benefit-badge-label">Security</span>
                        </header>
                        <figure class="benefit-figure">
                            <img src="https://images.unsplash.com/photo-1563986768609-322da13575f3?w=600&h=400&fit=crop" alt="Virtual Card">
                        </figure>
                        <div>
                            <h3 class="benefit-title">Virtual <em>Cards</em></h3>
                            <p class="benefit-desc">
                                Create disposable virtual cards for online shopping. Enhanced security with single-use numbers.
                            </p>
                        </div>
                        <footer class="benefit-footer">
                            <span class="benefit-tag">Instant</span>
                            <a href="#" class="benefit-link">Create →</a>
                        </footer>
                    </article>

                    <!-- Benefit 6: TAPP Drops -->
                    <article class="benefit-card">
                        <header class="benefit-meta-header">
                            <span class="benefit-index"><em>n°</em>006</span>
                            <span class="benefit-badge-label">Members Only</span>
                        </header>
                        <figure class="benefit-figure">
                            <img src="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=600&h=400&fit=crop" alt="TAPP Events">
                        </figure>
                        <div>
                            <h3 class="benefit-title">
                                Member <em>Events</em>
                                <span class="obra-tooltip-trigger">
                                    <span class="obra-tooltip-icon">i</span>
                                    <span class="obra-tooltip">Free or discounted access to exclusive events</span>
                                </span>
                            </h3>
                            <p class="benefit-desc">
                                Access exclusive events and experiences. Get free entry, VIP access, or special discounts at concerts, parties, and gatherings.
                            </p>
                        </div>
                        <footer class="benefit-footer">
                            <span class="benefit-tag">Exclusive Access</span>
                            <a href="#" class="benefit-link">Browse Events →</a>
                        </footer>
                    </article>
                </div>

                <!-- Interactive Section -->
                <section class="interactive-section">
                    <h2 class="section-title">Customize Your Experience</h2>
                    <p class="section-desc">Tell us your preferences to get better recommendations</p>

                    <div class="interactive-grid">
                        <!-- Radio Group -->
                        <div>
                            <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 20px; color: var(--ink);">
                                How often do you go out?
                            </h3>
                            <div class="vista-radios" role="radiogroup">
                                <label class="vista-radio">
                                    <input type="radio" name="frequency" checked />
                                    <span class="vista-radio__mark"></span>
                                    <span class="vista-radio__copy">
                                        <span class="vista-radio__title">Casual</span>
                                        <span class="vista-radio__meta">1-2 times per week</span>
                                    </span>
                                </label>
                                <label class="vista-radio">
                                    <input type="radio" name="frequency" />
                                    <span class="vista-radio__mark"></span>
                                    <span class="vista-radio__copy">
                                        <span class="vista-radio__title">Regular</span>
                                        <span class="vista-radio__meta">3-4 times per week</span>
                                    </span>
                                </label>
                                <label class="vista-radio">
                                    <input type="radio" name="frequency" />
                                    <span class="vista-radio__mark"></span>
                                    <span class="vista-radio__copy">
                                        <span class="vista-radio__title">Frequent</span>
                                        <span class="vista-radio__meta">5+ times per week</span>
                                    </span>
                                </label>
                            </div>
                        </div>

                        <!-- Input Fields -->
                        <div>
                            <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 20px; color: var(--ink);">
                                Notification Preferences
                            </h3>
                            <div class="fields-group">
                                <label class="cairn-field">
                                    <span class="cairn-field__label">Favorite Cuisine</span>
                                    <input class="cairn-field__input" type="text" placeholder="Italian, Japanese, Dominican..." />
                                    <span class="cairn-field__help">We'll notify you about related benefits</span>
                                </label>
                                <label class="cairn-field">
                                    <span class="cairn-field__label">Preferred Neighborhood</span>
                                    <input class="cairn-field__input" type="text" placeholder="Piantini, Zona Colonial..." />
                                    <span class="cairn-field__help">Get alerts for nearby drops and events</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- CTA Section -->
                <section class="cta-section">
                    <div class="cta-card">
                        <h2 class="cta-title">Ready for More?</h2>
                        <p class="cta-desc">
                            Upgrade to TAPP Premium and unlock 3x rewards at select merchants, 
                            VIP event access, priority support, and exclusive member-only drops.
                        </p>
                        <button class="vista-btn">
                            Upgrade to Premium
                            <svg viewBox="0 0 24 24">
                                <path d="M7 17 17 7" />
                                <path d="M7 7h10v10" />
                            </svg>
                        </button>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <script>
        // Mobile menu toggle
        const menuBtn = document.getElementById('menu_btn');
        const closeBtn = document.getElementById('btn_close');
        const sidebar = document.getElementById('sidebar');

        if (menuBtn) {
            menuBtn.addEventListener('click', () => {
                sidebar.classList.add('active');
            });
        }

        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                sidebar.classList.remove('active');
            });
        }

        // Close sidebar when clicking outside
        document.addEventListener('click', (e) => {
            if (sidebar.classList.contains('active') && 
                !sidebar.contains(e.target) && 
                !menuBtn.contains(e.target)) {
                sidebar.classList.remove('active');
            }
        });
    </script>
</body>
</html>
