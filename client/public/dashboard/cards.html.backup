<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cards - TAPP</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            text-decoration: none;
            border: none;
        }

        ::-webkit-scrollbar {
            display: none;
        }

        :root {
            --font-inter: 'Inter', -apple-system, sans-serif;
            --font-mono: 'JetBrains Mono', 'SF Mono', 'Courier New', monospace;
            --ink: #0e1116;
            --muted: #5b6472;
            --surface: #ffffff;
            --bg: #f8f9fa;
            --text-grey: #a1a3af;
            --border: rgba(15, 23, 42, 0.08);
            --border-strong: rgba(15, 23, 42, 0.12);
            --success: #10b981;
            --error: #ef4444;
            --warning: #f59e0b;
        }

        body {
            position: relative;
            width: 100%;
            min-height: 100vh;
            background: var(--bg);
            overflow-x: hidden;
            font-family: var(--font-inter);
        }

        @media screen and (min-width: 1024px) {
            body {
                zoom: 0.85;
                -moz-transform: scale(0.85);
                -moz-transform-origin: 0 0;
            }
        }

        /* Background gradients */
        body::after {
            content: '';
            position: fixed;
            top: -10%;
            right: -5%;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.08) 0%, transparent 70%);
            filter: blur(80px);
            z-index: -2;
        }

        body::before {
            content: '';
            position: fixed;
            bottom: -10%;
            left: -5%;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(124, 58, 237, 0.08) 0%, transparent 70%);
            filter: blur(80px);
            z-index: -1;
        }

        /* Container */
        .container {
            position: relative;
            width: 100vw;
            min-height: 100vh;
            display: grid;
            grid-template-columns: 280px 1fr;
            z-index: 10;
        }

        /* Sidebar - Same as other pages */
        nav {
            position: relative;
            width: 280px;
            height: 100vh;
            overflow-x: hidden;
            overflow-y: auto;
            background: url('https://raw.githubusercontent.com/shyamtala003/finance_dashboard/%40sjtala/images/bg2.png');
            background-attachment: fixed;
            background-size: 100%;
            background-repeat: no-repeat;
            background-position-y: 20%;
            background-position-x: 20%;
            border-right: 2px solid rgba(195, 195, 195, 0.8);
            font-family: var(--font-inter);
            z-index: 99;
            display: flex;
            flex-direction: column;
        }

        nav.sidebar #btn_close {
            position: absolute;
            top: 20px;
            right: 20px;
            display: none;
            place-content: center;
            padding: 8px;
            background: #ffffff;
            border-radius: 8px;
            cursor: pointer;
        }

        nav .logo {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 20px;
            flex-shrink: 0;
        }

        nav .logo svg {
            width: 40px;
            height: 40px;
        }

        nav .logo span {
            font-weight: 200;
            font-size: 24px;
            letter-spacing: 0.1em;
            text-transform: lowercase;
        }

        .nav_links {
            margin-top: 20px;
            width: 100%;
        }

        .nav_links a.nav_link {
            display: flex;
            gap: 12px;
            align-items: center;
            padding: 12px 20px;
            color: var(--text-grey);
            font-size: 15px;
            text-transform: capitalize;
            transition: all 0.3s ease;
            border-radius: 12px;
            margin: 4px 12px;
        }

        .nav_link_icon {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav_link_icon svg {
            stroke: var(--text-grey);
            transition: stroke 0.3s ease;
        }

        .nav_links a.nav_link:hover .nav_link_text,
        .nav_links a.active .nav_link_text {
            color: var(--ink);
        }

        .nav_links a.nav_link:hover .nav_link_icon svg,
        .nav_links a.active .nav_link_icon svg {
            stroke: var(--ink);
        }

        .nav_links a.active {
            background: rgba(0, 0, 0, 0.05);
        }

        .life_cover_offer {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            flex-shrink: 0;
        }

        .life_cover_offer img {
            width: 130px;
            height: 150px;
        }

        .life_cover_offer .life_cover_text {
            padding-inline: 20px;
            margin-top: 20px;
        }

        .life_cover_text p.title {
            font-size: 14px;
            color: var(--ink);
            font-weight: 600;
            text-align: center;
        }

        .life_cover_text p.desc {
            font-size: 12px;
            color: #464646;
            font-weight: 400;
            text-align: center;
        }

        .life_cover_offer a {
            margin-top: 20px;
            margin-inline: 20px;
            width: 85%;
            padding: 10px 20px;
            color: #0e1116;
            border: 1px solid rgba(15, 23, 42, 0.12);
            border-radius: 999px;
            text-transform: none;
            text-align: center;
            font-weight: 500;
            font-size: 13px;
            transition: all 180ms ease;
        }

        .life_cover_offer a:hover {
            background: #0e1116;
            color: #ffffff;
            border-color: #0e1116;
        }

        .profile {
            margin: 20px auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 85%;
            padding: 16px;
            background: #ffffff;
            border-radius: 30px;
            transition: all 180ms ease;
            cursor: pointer;
            flex-shrink: 0;
        }

        .profile .img_with_name {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .profile .img_with_name img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
        }

        .profile .img_with_name p.name {
            color: #0e1116;
            font-weight: 600;
            text-transform: none;
            line-height: 14px;
            font-size: 14px;
        }

        .profile .img_with_name p.occupation {
            color: #5b6472;
            text-transform: none;
            font-size: 13px;
            font-weight: 500;
        }

        .profile .icon {
            fill: #5b6472;
            transition: fill 180ms ease;
        }

        .profile:hover {
            background: rgba(14, 17, 22, 0.04);
        }

        .profile:hover .icon {
            fill: #0e1116;
        }

        /* Main content */
        .main-content {
            width: 100%;
            min-height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
        }

        /* Mobile menu button */
        #menu_btn {
            position: fixed;
            top: 24px;
            left: 24px;
            width: 44px;
            height: 44px;
            display: none;
            place-items: center;
            background: #ffffff;
            padding: 10px;
            border-radius: 14px;
            cursor: pointer;
            border: 1px solid var(--border);
            box-shadow: 0 2px 8px rgba(14, 17, 22, 0.08);
            z-index: 100;
            transition: all 180ms ease;
        }

        #menu_btn:hover {
            background: rgba(14, 17, 22, 0.04);
            border-color: var(--border-strong);
        }

        #menu_btn svg {
            fill: var(--ink);
        }

        /* Cards Container */
        .cards-container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 48px 60px;
        }

        /* Page Header */
        .page-header {
            margin-bottom: 48px;
            text-align: right;
        }

        .page-title {
            font-size: 56px;
            font-weight: 700;
            letter-spacing: -0.03em;
            color: var(--ink);
            margin-bottom: 16px;
        }

        .page-subtitle {
            font-size: 18px;
            color: var(--muted);
            line-height: 1.6;
            max-width: 700px;
            margin-left: auto;
        }

        /* Main Grid Layout */
        .cards-main-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        /* Card Showcase Section */
        .card-showcase-section {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 40px;
            position: relative;
            overflow: hidden;
        }

        .showcase-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
        }

        .showcase-title {
            font-size: 20px;
            font-weight: 700;
            letter-spacing: -0.01em;
            color: var(--ink);
        }

        .card-status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: rgba(16, 185, 129, 0.1);
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            color: var(--success);
        }

        .card-status-badge.locked {
            background: rgba(239, 68, 68, 0.1);
            color: var(--error);
        }

        .card-status-badge svg {
            width: 14px;
            height: 14px;
        }

        /* 3D Card Mockup */
        .card-mockup-container {
            perspective: 1000px;
            width: 100%;
            height: 420px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 32px;
        }

        .card-mockup {
            position: relative;
            width: 100%;
            max-width: 520px;
            height: 328px;
            transition: transform 0.6s;
            transform-style: preserve-3d;
        }

        .card-mockup.flipped {
            transform: rotateY(180deg);
        }

        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
            overflow: hidden;
        }

        /* TAPP Card Design - Exact Match from Dashboard */
        .card-front {
            background: linear-gradient(135deg, #0a0a0a 0%, #000000 100%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 32px;
            position: relative;
        }

        /* Subtle gradient overlay */
        .card-gradient-overlay {
            position: absolute;
            top: 0;
            right: 0;
            width: 60%;
            height: 100%;
            background: radial-gradient(ellipse at top right, rgba(255, 255, 255, 0.03) 0%, transparent 60%);
            pointer-events: none;
        }

        .card-back {
            background: linear-gradient(135deg, #0a0a0a 0%, #000000 100%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transform: rotateY(180deg);
            display: flex;
            flex-direction: column;
        }

        /* Card Front Elements - TAPP Style */
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            z-index: 2;
            position: relative;
        }

        .card-header svg {
            width: 36px;
            height: 36px;
        }

        .tapp-wordmark {
            font-family: var(--font-inter);
            font-size: 32px;
            font-weight: 200;
            letter-spacing: 0.2em;
            color: rgba(255, 255, 255, 0.95);
            margin: 0;
            text-transform: lowercase;
        }

        .card-footer-real {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            z-index: 2;
            position: relative;
            margin-top: auto;
        }

        .card-expiry-box {
            text-align: right;
        }

        .card-label-minimal {
            font-size: 10px;
            color: rgba(255, 255, 255, 0.3);
            text-transform: uppercase;
            margin-bottom: 6px;
            letter-spacing: 0.1em;
            font-weight: 500;
        }

        .card-value {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.9);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 400;
        }

        .card-value input {
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
            font-weight: 400;
            letter-spacing: 0.08em;
            outline: none;
            width: 100%;
            text-transform: uppercase;
        }

        .card-mono {
            font-family: 'Courier New', monospace;
        }

        /* Card Back Elements */
        .card-magnetic-strip {
            width: 100%;
            height: 60px;
            background: #000000;
            margin-top: 32px;
        }

        .card-back-content {
            padding: 32px;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .card-signature-panel {
            background: rgba(255, 255, 255, 0.9);
            height: 50px;
            border-radius: 6px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .signature-text {
            font-family: 'Brush Script MT', cursive;
            font-size: 20px;
            color: #1f2937;
        }

        .cvv-box {
            background: white;
            padding: 6px 12px;
            border-radius: 4px;
            font-family: var(--font-mono);
            font-size: 14px;
            font-weight: 600;
            color: #1f2937;
        }

        .card-back-info {
            color: rgba(255, 255, 255, 0.7);
            font-size: 11px;
            line-height: 1.6;
        }

        /* Flip Button */
        .flip-card-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 24px;
            background: var(--ink);
            color: white;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 180ms ease;
            border: none;
            width: 100%;
        }

        .flip-card-btn:hover {
            background: #1a1f28;
            transform: translateY(-2px);
        }

        .flip-card-btn svg {
            width: 16px;
            height: 16px;
        }

        /* Quick Actions */
        .quick-actions {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 20px;
        }

        .quick-action-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 14px 20px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
            cursor: pointer;
            transition: all 180ms ease;
        }

        .quick-action-btn:hover {
            border-color: var(--border-strong);
            background: rgba(14, 17, 22, 0.02);
        }

        .quick-action-btn svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
        }

        /* Controls Section */
        .card-controls-section {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Control Panel */
        .control-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 24px;
        }

        .control-panel-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .control-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: rgba(14, 17, 22, 0.04);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .control-icon svg {
            width: 20px;
            height: 20px;
            stroke: var(--ink);
        }

        .control-panel-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--ink);
        }

        .control-panel-desc {
            font-size: 12px;
            color: var(--muted);
            margin-top: 2px;
        }

        /* Toggle Switch */
        .toggle-control {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 0;
            border-bottom: 1px solid var(--border);
        }

        .toggle-control:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .toggle-label {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .toggle-title {
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
        }

        .toggle-subtitle {
            font-size: 12px;
            color: var(--muted);
        }

        .toggle-switch {
            position: relative;
            width: 48px;
            height: 28px;
            background: #d1d5db;
            border-radius: 999px;
            cursor: pointer;
            transition: all 180ms ease;
        }

        .toggle-switch.active {
            background: var(--ink);
        }

        .toggle-switch::after {
            content: '';
            position: absolute;
            top: 3px;
            left: 3px;
            width: 22px;
            height: 22px;
            background: white;
            border-radius: 999px;
            transition: all 180ms ease;
        }

        .toggle-switch.active::after {
            left: 23px;
        }

        /* Spending Limits */
        .spending-limit-control {
            padding: 16px 0;
        }

        .limit-input-group {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 12px;
        }

        .limit-input {
            flex: 1;
            padding: 12px 16px;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 14px;
            font-family: var(--font-mono);
            font-weight: 600;
            color: var(--ink);
            outline: none;
            transition: all 180ms ease;
        }

        .limit-input:focus {
            border-color: var(--ink);
        }

        .limit-btn {
            padding: 12px 20px;
            background: var(--ink);
            color: white;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 180ms ease;
        }

        .limit-btn:hover {
            background: #1a1f28;
        }

        /* Security Settings */
        .security-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
            margin-top: 16px;
        }

        .security-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px;
            background: var(--bg);
            border-radius: 10px;
            cursor: pointer;
            transition: all 180ms ease;
        }

        .security-item:hover {
            background: rgba(14, 17, 22, 0.04);
        }

        .security-item-icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .security-item-icon svg {
            width: 18px;
            height: 18px;
            stroke: var(--ink);
        }

        .security-item-content {
            flex: 1;
        }

        .security-item-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 2px;
        }

        .security-item-desc {
            font-size: 11px;
            color: var(--muted);
            line-height: 1.4;
        }

        /* Transaction History */
        .transaction-history-section {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 32px;
            margin-top: 40px;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .section-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--ink);
        }

        .view-all-link {
            font-size: 13px;
            font-weight: 600;
            color: var(--muted);
            cursor: pointer;
            transition: color 180ms ease;
        }

        .view-all-link:hover {
            color: var(--ink);
        }

        /* Transaction List */
        .transaction-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .transaction-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px;
            background: var(--bg);
            border-radius: 12px;
            transition: all 180ms ease;
        }

        .transaction-item:hover {
            background: rgba(14, 17, 22, 0.04);
        }

        .transaction-icon {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .transaction-icon svg {
            width: 20px;
            height: 20px;
            stroke: var(--ink);
        }

        .transaction-info {
            flex: 1;
        }

        .transaction-merchant {
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 2px;
        }

        .transaction-date {
            font-size: 12px;
            color: var(--muted);
        }

        .transaction-amount {
            font-family: var(--font-mono);
            font-size: 15px;
            font-weight: 700;
            color: var(--ink);
            text-align: right;
        }

        .transaction-amount.positive {
            color: var(--success);
        }

        .transaction-points {
            font-size: 11px;
            color: var(--success);
            font-weight: 600;
            text-align: right;
            margin-top: 2px;
        }

        /* Upgrade Card Section */
        .upgrade-card-section {
            background: linear-gradient(135deg, #1a1f28 0%, #0e1116 100%);
            border-radius: 24px;
            padding: 40px;
            margin-top: 40px;
            position: relative;
            overflow: hidden;
        }

        .upgrade-card-section::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            border-radius: 50%;
            transform: translate(40%, -40%);
        }

        .upgrade-content {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
        }

        .upgrade-text {
            flex: 1;
        }

        .upgrade-badge {
            display: inline-block;
            padding: 6px 12px;
            background: rgba(245, 158, 11, 0.2);
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #fbbf24;
            margin-bottom: 16px;
        }

        .upgrade-title {
            font-size: 32px;
            font-weight: 700;
            color: white;
            margin-bottom: 12px;
            letter-spacing: -0.02em;
        }

        .upgrade-description {
            font-size: 15px;
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .upgrade-features {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 24px;
        }

        .upgrade-feature {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.9);
        }

        .upgrade-feature svg {
            width: 16px;
            height: 16px;
            stroke: #10b981;
        }

        .upgrade-btn {
            padding: 14px 32px;
            background: white;
            color: #0e1116;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 180ms ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .upgrade-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(255, 255, 255, 0.2);
        }

        .upgrade-btn svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            body {
                zoom: 1;
            }

            .container {
                grid-template-columns: 1fr;
            }

            nav {
                position: fixed;
                left: -100%;
                top: 0;
                height: 100vh;
                z-index: 999;
                transition: left 0.3s ease;
                background: #ffffff;
                background: #ffffff;
            }

            nav.active {
                left: 0;
            }

            nav.sidebar #btn_close {
                display: grid;
            }

            #menu_btn {
                display: grid;
            }

            .cards-container {
                padding: 80px 20px 32px;
            }

            .page-title {
                font-size: 32px;
            }

            .page-subtitle {
                font-size: 15px;
            }

            .cards-main-grid {
                grid-template-columns: 1fr;
                gap: 24px;
            }

            .card-mockup-container {
                height: 190px;
                padding: 0 12px;
            }

            .card-mockup {
                max-width: 320px;
                height: 190px;
            }

            /* Ensure card stays centered during flip on mobile */
            .card-mockup {
                position: relative;
                left: 0;
                top: 0;
                transform-origin: center center;
            }

            .card-mockup.flipped {
                transform: rotateY(180deg);
            }

            .card-front,
            .card-back {
                padding: 15px 18px;
                border-radius: 12px;
            }

            /* TAPP card styling - mobile */
            .card-header svg {
                width: 19px;
                height: 19px;
            }

            .tapp-wordmark {
                font-size: 17px;
                letter-spacing: 0.16em;
            }

            .card-label-minimal {
                font-size: 7px;
                margin-bottom: 2px;
            }

            .card-value {
                font-size: 9.5px;
            }

            .upgrade-content {
                flex-direction: column;
                text-align: center;
            }

            .upgrade-features {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Sidebar -->
        <nav class="sidebar" id="sidebar">
            <button id="btn_close">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16">
                    <path fill="none" d="M0 0h24v24H0z" />
                    <path d="M12 10.586l4.95-4.95 1.414 1.414-4.95 4.95 4.95 4.95-1.414 1.414-4.95-4.95-4.95 4.95-1.414-1.414 4.95-4.95-4.95-4.95L7.05 5.636z" fill="currentColor"/>
                </svg>
            </button>
            <div class="logo">
                <svg width="40" height="40" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="16" cy="16" r="2.5" fill="currentColor" />
                    <path d="M16 9C12.134 9 9 12.134 9 16C9 19.866 12.134 23 16 23" 
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
                    <path d="M16 5C9.925 5 5 9.925 5 16C5 22.075 9.925 27 16 27" 
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
                </svg>
                <span>tapp</span>
            </div>
            <div class="nav_links">
                <a href="/dashboard/user" class="nav_link">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7"/>
                            <rect x="14" y="3" width="7" height="7"/>
                            <rect x="14" y="14" width="7" height="7"/>
                            <rect x="3" y="14" width="7" height="7"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Dashboard</div>
                </a>
                <a href="/dashboard/benefits" class="nav_link">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 7h-9"/>
                            <path d="M14 17H5"/>
                            <circle cx="17" cy="17" r="3"/>
                            <circle cx="7" cy="7" r="3"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Benefits</div>
                </a>
                <a href="/dashboard/events" class="nav_link">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Events</div>
                </a>
                <a href="/dashboard/explore" class="nav_link">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Explore</div>
                </a>
                <a href="/dashboard/cards" class="nav_link active">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="5" width="20" height="14" rx="2"/>
                            <line x1="2" y1="10" x2="22" y2="10"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Cards</div>
                </a>
                <a href="#" class="nav_link">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/>
                            <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/>
                            <path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Wallet</div>
                </a>
                <a href="#" class="nav_link">
                    <div class="nav_link_icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </svg>
                    </div>
                    <div class="nav_link_text">Settings</div>
                </a>
            </div>
            <div class="life_cover_offer">
                <img src="https://raw.githubusercontent.com/shyamtala003/finance_dashboard/%40sjtala/images/women.svg" alt="" />
                <div class="life_cover_text">
                    <p class="title">Congratulations!</p>
                    <p class="desc">You'r eligible for instant Life cover upto 2,00,000 without any medical test for documentation</p>
                </div>
                <a href="#">buy now</a>
            </div>
            <div class="profile">
                <div class="img_with_name">
                    <img src="https://raw.githubusercontent.com/shyamtala003/finance_dashboard/%40sjtala/images/profile_pic.webp" alt="">
                    <div>
                        <p class="name">shyam tala</p>
                        <p class="occupation">Bussiness</p>
                    </div>
                </div>
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20">
                    <path d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8.009 8.009 0 0 1-8 8z"/>
                    <path d="M12 6a3.5 3.5 0 0 0-3.5 3.5h2A1.5 1.5 0 1 1 12 11a1 1 0 0 0-1 1v2h2v-1.16A3.49 3.49 0 0 0 12 6zm-1 9h2v2h-2z"/>
                </svg>
            </div>
        </nav>

        <!-- Mobile menu button -->
        <button id="menu_btn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24">
                <path fill="none" d="M0 0h24v24H0z"/>
                <path d="M3 4h18v2H3V4zm0 7h18v2H3v-2zm0 7h18v2H3v-2z"/>
            </svg>
        </button>

        <!-- Main Content -->
        <div class="main-content">
            <div class="cards-container">
                <!-- Page Header -->
                <div class="page-header">
                    <h1 class="page-title">Cards</h1>
                    <p class="page-subtitle">Manage your TAPP cards, settings, and security preferences. Full control at your fingertips.</p>
                </div>

                <!-- Main Grid -->
                <div class="cards-main-grid">
                    <!-- Card Showcase -->
                    <div class="card-showcase-section">
                        <div class="showcase-header">
                            <h2 class="showcase-title">Your TAPP Card</h2>
                            <div class="card-status-badge">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                    <polyline points="22 4 12 14.01 9 11.01"/>
                                </svg>
                                Active
                            </div>
                        </div>

                        <!-- 3D Card Mockup -->
                        <div class="card-mockup-container">
                            <div class="card-mockup" id="cardMockup">
                                <!-- Front -->
                                <div class="card-face card-front">
                                    <!-- Subtle gradient overlay -->
                                    <div class="card-gradient-overlay"></div>
                                    
                                    <!-- Header: NFC + tapp logo -->
                                    <div class="card-header">
                                        <svg width="36" height="36" viewBox="0 0 32 32" fill="none">
                                            <circle cx="16" cy="16" r="2" fill="rgba(255,255,255,0.9)" />
                                            <path d="M16 10C12.6863 10 10 12.6863 10 16C10 19.3137 12.6863 22 16 22" 
                                                stroke="rgba(255,255,255,0.4)" stroke-width="1.5" stroke-linecap="round"/>
                                            <path d="M16 6C10.4772 6 6 10.4772 6 16C6 21.5228 10.4772 26 16 26" 
                                                stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-linecap="round"/>
                                        </svg>
                                        <h2 class="tapp-wordmark">tapp</h2>
                                    </div>

                                    <!-- Footer: Member name + expiry -->
                                    <div class="card-footer-real">
                                        <div>
                                            <div class="card-label-minimal">Member</div>
                                            <div class="card-value">Cardholder</div>
                                        </div>
                                        <div class="card-expiry-box">
                                            <div class="card-label-minimal">Valid thru</div>
                                            <div class="card-value card-mono">12/27</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Back -->
                                <div class="card-face card-back">
                                    <div class="card-magnetic-strip"></div>
                                    <div class="card-back-content">
                                        <div class="card-signature-panel">
                                            <span class="signature-text">Miguel Torres</span>
                                            <span class="cvv-box">***</span>
                                        </div>
                                        <div class="card-back-info">
                                            This card is property of TAPP Network. If found, please return to any TAPP location or call +1-809-XXX-XXXX. Unauthorized use is prohibited.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Flip Button -->
                        <button class="flip-card-btn" onclick="flipCard()">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="1 4 1 10 7 10"/>
                                <polyline points="23 20 23 14 17 14"/>
                                <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/>
                            </svg>
                            Flip Card
                        </button>

                        <!-- Quick Actions -->
                        <div class="quick-actions">
                            <button class="quick-action-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                </svg>
                                Lock Card
                            </button>
                            <button class="quick-action-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                                Change PIN
                            </button>
                            <button class="quick-action-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                                View Details
                            </button>
                            <button class="quick-action-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="12" y1="18" x2="12" y2="12"/>
                                    <line x1="9" y1="15" x2="15" y2="15"/>
                                </svg>
                                Report Issue
                            </button>
                        </div>
                    </div>

                    <!-- Controls -->
                    <div class="card-controls-section">
                        <!-- Card Status Control -->
                        <div class="control-panel">
                            <div class="control-panel-header">
                                <div class="control-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                        <rect x="3" y="7" width="18" height="13" rx="2"/>
                                        <path d="M7 7V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="control-panel-title">Card Status</div>
                                    <div class="control-panel-desc">Manage card activation and restrictions</div>
                                </div>
                            </div>
                            <div class="toggle-control">
                                <div class="toggle-label">
                                    <div class="toggle-title">Card Enabled</div>
                                    <div class="toggle-subtitle">Allow transactions with this card</div>
                                </div>
                                <div class="toggle-switch active" onclick="toggleSwitch(this)"></div>
                            </div>
                            <div class="toggle-control">
                                <div class="toggle-label">
                                    <div class="toggle-title">Contactless Payments</div>
                                    <div class="toggle-subtitle">Tap-to-pay at merchants</div>
                                </div>
                                <div class="toggle-switch active" onclick="toggleSwitch(this)"></div>
                            </div>
                            <div class="toggle-control">
                                <div class="toggle-label">
                                    <div class="toggle-title">Online Transactions</div>
                                    <div class="toggle-subtitle">E-commerce and app purchases</div>
                                </div>
                                <div class="toggle-switch active" onclick="toggleSwitch(this)"></div>
                            </div>
                            <div class="toggle-control">
                                <div class="toggle-label">
                                    <div class="toggle-title">International Usage</div>
                                    <div class="toggle-subtitle">Use card outside Dominican Republic</div>
                                </div>
                                <div class="toggle-switch" onclick="toggleSwitch(this)"></div>
                            </div>
                        </div>

                        <!-- Spending Limits -->
                        <div class="control-panel">
                            <div class="control-panel-header">
                                <div class="control-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                        <circle cx="12" cy="12" r="9"/>
                                        <path d="M12 6v6l3 3"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="control-panel-title">Spending Controls</div>
                                    <div class="control-panel-desc">Set daily and monthly limits</div>
                                </div>
                            </div>
                            <div class="spending-limit-control">
                                <div class="toggle-label" style="margin-bottom: 8px;">
                                    <div class="toggle-title">Daily Limit</div>
                                    <div class="toggle-subtitle">Maximum spending per day</div>
                                </div>
                                <div class="limit-input-group">
                                    <input type="text" class="limit-input" placeholder="RD$ 5,000" value="RD$ 10,000">
                                    <button class="limit-btn">Update</button>
                                </div>
                            </div>
                            <div class="spending-limit-control">
                                <div class="toggle-label" style="margin-bottom: 8px;">
                                    <div class="toggle-title">Monthly Limit</div>
                                    <div class="toggle-subtitle">Maximum spending per month</div>
                                </div>
                                <div class="limit-input-group">
                                    <input type="text" class="limit-input" placeholder="RD$ 50,000" value="RD$ 100,000">
                                    <button class="limit-btn">Update</button>
                                </div>
                            </div>
                        </div>

                        <!-- Security Settings -->
                        <div class="control-panel">
                            <div class="control-panel-header">
                                <div class="control-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                        <path d="M12 2L4 6v6c0 5.5 3.8 10.7 8 12 4.2-1.3 8-6.5 8-12V6l-8-4z"/>
                                    </svg>
                                </div>
                                <div>
                                    <div class="control-panel-title">Security</div>
                                    <div class="control-panel-desc">Protection and authentication</div>
                                </div>
                            </div>
                            <div class="security-grid">
                                <div class="security-item">
                                    <div class="security-item-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                            <path d="M18 8A6 6 0 1 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                                        </svg>
                                    </div>
                                    <div class="security-item-content">
                                        <div class="security-item-title">Transaction Notifications</div>
                                        <div class="security-item-desc">Real-time alerts for every purchase</div>
                                    </div>
                                </div>
                                <div class="security-item">
                                    <div class="security-item-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                            <path d="M7 10v12"/>
                                            <path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"/>
                                        </svg>
                                    </div>
                                    <div class="security-item-content">
                                        <div class="security-item-title">Biometric Authentication</div>
                                        <div class="security-item-desc">Fingerprint or Face ID verification</div>
                                    </div>
                                </div>
                                <div class="security-item">
                                    <div class="security-item-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                            <circle cx="12" cy="10" r="3"/>
                                            <path d="M12 2a8 8 0 0 0-8 8c0 1.892.402 3.13 1.5 4.5L12 22l6.5-7.5c1.098-1.37 1.5-2.608 1.5-4.5a8 8 0 0 0-8-8z"/>
                                        </svg>
                                    </div>
                                    <div class="security-item-content">
                                        <div class="security-item-title">Location Restrictions</div>
                                        <div class="security-item-desc">Block transactions outside trusted areas</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Transaction History -->
                <div class="transaction-history-section">
                    <div class="section-header">
                        <h2 class="section-title">Recent Activity</h2>
                        <a class="view-all-link">View All →</a>
                    </div>
                    <div class="transaction-list">
                        <div class="transaction-item">
                            <div class="transaction-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                                    <polyline points="9 22 9 12 15 12 15 22"/>
                                </svg>
                            </div>
                            <div class="transaction-info">
                                <div class="transaction-merchant">La Parrillada</div>
                                <div class="transaction-date">Today at 7:32 PM</div>
