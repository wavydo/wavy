      </div>
    </section>

    {/* Features Section - Tech Showcase */}
    <section style={{
      minHeight: '100vh',
      width: '100%',
      position: 'relative',
      zIndex: 10,
      backgroundColor: 'rgba(0,0,0,0.8)',
      backdropFilter: 'blur(10px)',
      padding: '10vh 5vw',
      display: 'flex',
      alignItems: 'center'
    }}>
      <div style={{ maxWidth: '1800px', margin: '0 auto', width: '100%' }}>
        
