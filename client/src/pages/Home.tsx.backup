                        width: '100%',
                        padding: '12px 16px',
                        textAlign: 'left',
                        backgroundColor: 'transparent',
                        color: 'rgba(255, 255, 255, 0.3)',
                        border: 'none',
                        cursor: 'not-allowed',
                        fontSize: '14px',
                        opacity: 0.5
                      }}
                      data-testid="menu-sponsoring"
                    >
                      Sponsoring
                    </button>
                  </div>
                )}
              </div>
            </div>
          </div>
          
          <button 
            className="button-cam-element switch fixed top-4 right-4 md:top-auto md:bottom-4 md:right-4 z-50"
            onClick={() => window.location.href = 'mailto:support@tapp.do'}
            data-testid="button-support"
            title="Contactar Soporte"
          >
            <span className="icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="9" stroke="white" strokeWidth="2"/>
                <circle cx="12" cy="12" r="5" fill="white"/>
                <rect x="11" y="3" width="2" height="4" fill="white" rx="1"/>
                <rect x="11" y="17" width="2" height="4" fill="white" rx="1"/>
                <rect x="3" y="11" width="4" height="2" fill="white" rx="1"/>
                <rect x="17" y="11" width="4" height="2" fill="white" rx="1"/>
              </svg>
            </span>
          </button>
        </div>
      </div>
    </section>

    {/* About Section - Professional */}
    <section style={{
      minHeight: '100vh',
      width: '100%',
      position: 'relative',
      zIndex: 10,
      backgroundColor: 'rgba(0,0,0,0.75)',
      backdropFilter: 'blur(10px)',
      padding: '10vh 5vw',
      display: 'flex',
      alignItems: 'center'
    }}>
      <div style={{ maxWidth: '1800px', margin: '0 auto', width: '100%' }}>
        
        {/* Stats Grid - Apple Style */}
        <div style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(3, 1fr)',
          gap: '1px',
          backgroundColor: 'rgba(255,255,255,0.08)',
          borderRadius: '24px',
          overflow: 'hidden',
          marginBottom: '12vh'
        }}>
          {[
            { 
              num: '100+', 
              label: 'Information Filters',
              icon: <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5"><path d="M3 4h18v2H3zM6 8h12v2H6zM9 12h6v2H9z"/><circle cx="12" cy="18" r="2"/></svg>
            },
            { 
              num: '+20', 
              label: 'IV Data Centers',
              icon: <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            },
            { 
              num: '100%', 
              label: 'Safe Place',
              icon: <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5"><path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z"/><path d="M9 12l2 2 4-4"/></svg>
            }
          ].map((stat, i) => (
            <div key={i} style={{
              padding: '5vh 3vw',
              background: 'rgba(0,0,0,0.4)',
              backdropFilter: 'blur(20px)',
              display: 'flex',
              flexDirection: 'column',
              alignItems: 'center',
              justifyContent: 'center',
              textAlign: 'center',
              minHeight: '35vh',
              transition: 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)',
              cursor: 'pointer'
            }}
            onMouseEnter={(e) => {
              e.currentTarget.style.background = 'rgba(255,255,255,0.05)';
              e.currentTarget.style.transform = 'translateY(-8px)';
            }}
            onMouseLeave={(e) => {
              e.currentTarget.style.background = 'rgba(0,0,0,0.4)';
              e.currentTarget.style.transform = 'translateY(0)';
            }}>
              <div style={{ color: 'rgba(255,255,255,0.3)', marginBottom: '3vh' }}>{stat.icon}</div>
              <div style={{ 
                fontSize: 'clamp(3rem, 6vw, 5rem)', 
                fontWeight: 200, 
                color: '#fff', 
                marginBottom: '2vh',
                letterSpacing: '-0.03em',
                lineHeight: 0.9
              }}>{stat.num}</div>
              <div style={{ 
                fontSize: 'clamp(0.85rem, 1vw, 1rem)', 
                color: 'rgba(255,255,255,0.5)', 
                textTransform: 'uppercase', 
                letterSpacing: '0.15em',
                fontWeight: 600
              }}>{stat.label}</div>
            </div>
          ))}
        </div>

        {/* Values - Copied from About */}
        <div className="section-header" style={{ textAlign: 'center', marginBottom: '8vh' }}>
          <span className="about-label" style={{
            fontSize: 'clamp(0.7rem, 0.9vw, 0.85rem)',
            fontWeight: 700,
            letterSpacing: '0.2em',
            color: 'rgba(255,255,255,0.35)',
            marginBottom: '2vh',
            textTransform: 'uppercase',
            display: 'block'
          }}>Our Values</span>
          <h2 className="about-cards-title" style={{ 
            fontSize: 'clamp(2.5rem, 4.5vw, 4rem)', 
            fontWeight: 200, 
            color: '#fff',
            letterSpacing: '-0.02em'
          }}>
            What <span className="gradient-text" style={{ 
              background: 'linear-gradient(90deg, #667eea 0%, #764ba2 100%)',
              WebkitBackgroundClip: 'text',
              WebkitTextFillColor: 'transparent',
              backgroundClip: 'text'
            }}>defines us</span>
          </h2>
        </div>

        <div className="about-cards-grid">
          <FancyCard
            cardIndex={0}
            icon={
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round" strokeLinejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z" />
                <path d="M2 17l10 5 10-5" />
                <path d="M2 12l10 5 10-5" />
              </svg>
            }
            title="Professionalism"
            description="Developing something for traders who value excellence and reject noise."
          />

          <FancyCard
